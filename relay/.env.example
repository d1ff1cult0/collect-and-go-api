# Het gedeelde geheim met Prijsspoor (COGO_RELAY_SECRET daar), minstens 16 tekens.
# Maak er een met: openssl rand -hex 24
RELAY_SECRET=

# Op welk IP de poort luistert. Zet hier je Tailscale-IP (tailscale ip -4), niet 0.0.0.0.
RELAY_BIND=127.0.0.1

# Optioneel: een proxy waarlangs de relay Collect&Go opvraagt. Leeg = het IP van deze
# machine. Gebruik enkel een proxy die daarvoor bedoeld is en waarvan de eigenaar dit
# gebruik goedkeurde.
# RELAY_PROXY=http://proxy.example:3128
