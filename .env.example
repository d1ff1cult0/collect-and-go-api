# Kopieer naar .env naast docker-compose.yml.
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
SCRAPE_INTERVAL_HOURS=6
# ADMIN_TOKEN=

# Collect&Go weigert het IP van de meeste servers (HTTP 456). Zie README,
# "Geblokkeerd door Collect&Go".
# COGO_RELAY_URL=http://100.x.y.z:8787
# COGO_RELAY_SECRET=
# COGO_RELAY_MODE=fallback     # of: always
# COGO_PROXY=socks5://100.x.y.z:1080

# Enkel voor de relay naast Prijsspoor (profiel `relay`):
# COMPOSE_PROFILES=relay
# RELAY_PROXY=http://residentiele-proxy.example:3128
